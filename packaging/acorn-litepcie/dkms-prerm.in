#!/bin/sh
set -e
# fpgas-online-acorn-litepcie-dkms: remove this version's modules from every kernel, as dh_dkms's prerm does.

case "$1" in
    remove|upgrade|deconfigure)
        if [ -n "$(dkms status -m @NAME@ -v @VERSION@)" ]; then
            dkms remove -m @NAME@ -v @VERSION@ --all
        fi
        ;;
esac
