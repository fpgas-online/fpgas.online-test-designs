# Installed by fpgas-online-acorn-tools. Runs designs/acorn-pcie/host/acorn_verify.py once per boot: which
# image the Acorn runs, and whether its flash holds the pinned release's images. Reads only; never writes
# the flash. On a Pi with no FPGA on PCIe it reports "none" and exits 0. The result is in
# /run/fpgas-online/acorn-verify.json and is published as the fleet-event stage `fpga-verified`.
[Unit]
Description=Check the Acorn's running image and flash against the installed release
Documentation=https://github.com/fpgas-online/fpgas.online-test-designs/blob/main/designs/acorn-pcie/host/acorn_verify.py
Wants=network-online.target
After=network-online.target fpgas-fleet-agent.service
ConditionPathExists=/usr/share/fpgas-online/acorn-pcie/images/manifest.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/fpgas-acorn-verify
# The flash read is ~7.6 s on pi-sw2-p48 (4.6 MiB over BAR0); leave room for a slow publish.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
