# Installed by fpgas-online-verify; turned on by fpgas-online-<board> (or fpgas-online-multi-board
# and so fpgas-online-all-boards). Runs fpgas-verify once per boot: check the board (or boards) the host is set
# up for, with the fpgas.online test bitstreams, and compare it with the state recorded last time. The board
# is left running a test design. The result is in /run/fpgas-online/verify.json; anything but "pass" leaves
# this unit failed. Nothing is sent anywhere unless /etc/fpgas-verify/*.ini says `[verify] publish = on`, as the
# fpgas.online Pi root does: then it publishes the fleet-event stage `fpga-verifying` as it starts and the
# result as the stage `fpga-verified`.
# To accept a board flashed or swapped on purpose: sudo fpgas-verify --update.
# Options (for example --no-probe): FPGAS_VERIFY_ARGS in /etc/default/fpgas-verify.
[Unit]
Description=Verify this Pi's FPGA board with the fpgas.online test bitstreams
Documentation=https://github.com/fpgas-online/fpgas.online-test-designs/blob/main/docs/verify.md https://github.com/fpgas-online/fpgas.online-test-designs/blob/main/docs/plans/2026-09-26-fpgas-online-verify-design.md
Wants=network-online.target
# After the fleet agent: the site knows the Pi is up (registered, online) before the check starts, and hears
# `fpga-verifying` when it does, so it can say the board is being verified rather than show nothing.
After=network-online.target fpgas-fleet-agent.service
# The Pi is not ready for anyone to use until its board is verified, so what serves it waits for this check to
# finish: the TT site's bridge, which also holds the TT board's USB serial port. Ordering only: a failed check
# still lets it start, and nothing here holds up ssh, so someone can log in and look. The fleet agent must not
# be After=fpgas-tt.service (setup-pi): with this line that is an ordering cycle, which systemd breaks by
# dropping a start job.
Before=fpgas-tt.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/fpgas-verify
ExecStart=/usr/bin/fpgas-verify $FPGAS_VERIFY_ARGS
# Each test loads a bitstream (openocd over GPIO JTAG on a Pi 3 takes a minute or more) and waits for its BIOS,
# and the Arty and NeTV2 flash is read back after.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
