# Installed and enabled by fpgas-online-verify. Runs designs/_host/fpgas_verify.py once per boot: find which
# fpgas.online FPGA board this Pi has (from the boards registered in /usr/share/fpgas-online/verify.d/ by the
# fpgas-online-<board>-tools packages) and run that board's verify. The verify loads test bitstreams into the
# board, so the board is left running a test design. The result is in /run/fpgas-online/verify.json and each
# board's own report beside it, and is published as the fleet-event stage `fpga-verified`.
# Options (for example --no-jtag-scan, or --board netv2 to skip detection): FPGAS_VERIFY_ARGS in
# /etc/default/fpgas-verify.
[Unit]
Description=Find this Pi's FPGA board and verify it with the fpgas.online test bitstreams
Documentation=https://github.com/fpgas-online/fpgas.online-test-designs/blob/main/designs/_host/fpgas_verify.py
Wants=network-online.target
After=network-online.target fpgas-fleet-agent.service
ConditionPathExistsGlob=/usr/share/fpgas-online/verify.d/*.json

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/fpgas-verify
ExecStart=/usr/bin/fpgas-verify $FPGAS_VERIFY_ARGS
# Each test loads a bitstream (openocd over GPIO JTAG on a Pi 3 takes a minute or more) and waits for its
# BIOS; a board has up to three tests.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
